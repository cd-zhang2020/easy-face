	font-size: 24rpx;
	color: #E0E7FF;
}

/* ========== 人数 Chip ========== */
.count-chip {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	margin: 24rpx 24rpx 8rpx;
	padding: 18rpx 24rpx;
	border-radius: 16rpx;
	background-color: #FFFFFF;
	border: 2rpx solid rgba(0, 0, 0, 0.06);
	box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.count-ok {
	border-color: rgba(16, 185, 129, 0.35);
	background-color: #ECFDF5;
}

.count-empty {
	border-color: rgba(239, 68, 68, 0.35);
	background-color: #FEF2F2;
}

.count-dot {
	width: 14rpx;
	height: 14rpx;
	border-radius: 999rpx;
	margin-right: 14rpx;
}

.count-ok .count-dot {
	background-color: #10B981;
}

.count-empty .count-dot {
	background-color: #EF4444;
}

.count-text {
	font-size: 26rpx;
	color: #334155;
}

.count-empty .count-text {
	color: #DC2626;
}

/* ========== 卡片 ========== */
.section {
	margin: 24rpx 24rpx 0;
	background-color: #FFFFFF;
	border-radius: 16rpx;
	padding: 28rpx 28rpx;
	box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.glass {
	background-color: #F5F7FF;
	border: 2rpx solid #E0E7FF;
}

.section-title {
	font-size: 30rpx;
	font-weight: 600;
	color: #2c3e50;
	margin-bottom: 20rpx;
}

/* ========== 表单 ========== */
.form-item {
	margin-bottom: 24rpx;
}

.form-item.row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
}

.label {
	font-size: 28rpx;
	color: #606266;
	margin-bottom: 10rpx;
}

.label-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 10rpx;
}

.label-value {
	font-size: 26rpx;
	color: #6366F1;
	font-weight: 600;
}

.slider {
	width: 100%;
}

.slider-range {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	margin-top: 4rpx;
}

.range-text {
	font-size: 22rpx;
	color: #909399;
}

/* ========== 启动按钮 ========== */
.btn-launch {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 92rpx;
	border-radius: 16rpx;
	background-color: #6366F1;
	box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.4);
}

.btn-launch:active {
	transform: translateY(4rpx);
	box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.35);
}

.btn-launch-disabled {
	opacity: 0.6;
}

.launch-text {
	font-size: 30rpx;
	font-weight: 600;
	color: #FFFFFF;
}

.launch-hint {
	font-size: 22rpx;
