	height: 100%;
	background-color: #f5f6fa;
	padding-bottom: 60rpx;
}

/* ========== 头部 ========== */
.header {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 48rpx 32rpx 28rpx;
	background-color: #667eea;
}

