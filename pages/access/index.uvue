<template>
	<scroll-view class="container" scroll-y="true">
		<!-- 头部 -->
		<view class="header">
			<view class="header-badge">ACCESS</view>
			<text class="title">智能门禁 · 多对多人脸核验</text>
			<text class="subtitle">离线 1:N 闸机识别 · 毫秒级检索</text>
		</view>

		<!-- 已录入人数提示 -->
		<view class="count-chip" :class="faceCount > 0 ? 'count-ok' : 'count-empty'">
			<text class="count-dot"></text>
			<text class="count-text" v-if="faceCount > 0">已录入 {{faceCount}} 人 · 可立即核验</text>
			<text class="count-text" v-else>暂无录入人脸 · 请先去录入</text>
		</view>

		<!-- 基础配置 -->
		<view class="section glass">
			<text class="section-title">核验参数</text>

			<view class="form-item">
				<view class="label-row">
					<text class="label">相似度阈值</text>
					<text class="label-value">{{threshold.toFixed(2)}}</text>
				</view>
				<slider
					class="slider"
					:value="threshold"
					@change="onThresholdChange"
					:min="0.5"
					:max="0.95"
					:step="0.01"
				/>
				<view class="slider-range">
					<text class="range-text">0.50</text>
					<text class="range-text">0.95</text>
				</view>
			</view>

			<view class="form-item row">
				<text class="label">启用静默活体检测</text>
				<switch :checked="needLiveness" @change="onLivenessChange" />
			</view>
		</view>

		<!-- 启动按钮 -->
		<view class="section">
			<view class="btn-launch" :class="isProcessing ? 'btn-launch-disabled' : ''" @tap="onStartAccess">
				<text class="launch-text">{{isProcessing ? '核验中...' : '启动门禁识别'}}</text>
			</view>
			<text class="launch-hint">点击后摄像头将持续对所有已录入人脸做 1:N 检索</text>
		</view>

		<!-- 结果展示 -->
		<view class="section" v-if="resultVisible">
			<text class="section-title">核验结果</text>
			<view class="result-card" :class="resultCardClass">
				<view class="result-glow"></view>
				<view class="result-badge">{{resultBadge}}</view>
				<text class="result-title">{{resultTitle}}</text>

				<view class="result-item" v-if="lastResult.faceID != ''">
					<text class="result-label">匹配用户</text>
					<text class="result-value">{{lastResult.faceID}}</text>
				</view>
				<view class="result-item" v-if="similarityText != ''">
					<text class="result-label">最佳相似度</text>
					<text class="result-value highlight">{{similarityText}}%</text>
				</view>
				<view class="result-item">
					<text class="result-label">状态码</text>
					<text class="result-value">{{lastResult.code}}</text>
				</view>
				<view class="result-item">
					<text class="result-label">描述</text>
					<text class="result-value">{{lastResult.msg}}</text>
				</view>
			</view>

			<button class="btn-clear" @tap="clearResult">清除结果</button>
		</view>

		<!-- 底部：前往录入 -->
		<view class="footer">
			<text class="footer-link" @tap="goEnroll">前往录入人脸 ›</text>
		</view>

		<view class="bottom-spacer"></view>
	</scroll-view>
</template>

<script setup lang="uts">
import {
	startFaceAccessActivity,
	getFaceCount,
	toastMessage,
	ResultJSON,
} from '@/uni_modules/easy-face'

// ==========================================
// 响应式状态
// ==========================================
const threshold = ref<number>(0.60)
const needLiveness = ref<boolean>(true)
const faceCount = ref<number>(0)
const resultVisible = ref<boolean>(false)
const isProcessing = ref<boolean>(false)

const lastResult = ref<ResultJSON>({
	code: 0,
	msg: '',
	faceID: '',
	similarity: 0,
	liveness: -1,
	faceFeature: '',
	faceBase64: '',
})

// ==========================================
// 计算属性
// ==========================================
const resultCardClass = computed<string>((): string => {
	const code = lastResult.value.code
	if (code == 1) return 'result-granted'
	if (code == 2 || code == 6) return 'result-denied'
	return 'result-idle'
})

const resultBadge = computed<string>((): string => {
	const code = lastResult.value.code
	if (code == 1) return '✓'
	if (code == 2 || code == 6) return '✕'
	return '•'
})

const resultTitle = computed<string>((): string => {
	const code = lastResult.value.code
	if (code == 1) return '开门成功'
	if (code == 2) return '未匹配到已注册人员'
	if (code == 6) return '请先录入人脸特征'
	return '等待核验'
})

// 注意：模板中不能直接对 UTS 类型的 number 字段做 >/* 运算（编译为 Number 后运算符无法解析），统一在此计算
const similarityText = computed<string>((): string => {
	const score = lastResult.value.similarity
	if (score <= 0) return ''
	return (score * 100).toFixed(2)
})

// ==========================================
// 生命周期
// ==========================================
onLoad(() => {
	faceCount.value = getFaceCount()
})

// ==========================================
// 工具方法
// ==========================================
function onThresholdChange(e : SliderChangeEvent): void {
	threshold.value = (e.detail.value as number)
}

function onLivenessChange(e : SwitchChangeEvent): void {
	needLiveness.value = (e.detail.value as boolean)
}

function showResult(result: ResultJSON): void {
	lastResult.value = result
	resultVisible.value = true
	isProcessing.value = false
}

function clearResult(): void {
	lastResult.value = {
		code: 0,
		msg: '',
		faceID: '',
		similarity: 0,
		liveness: -1,
		faceFeature: '',
		faceBase64: '',
	} as ResultJSON
	resultVisible.value = false
}

// ==========================================
// 门禁启动
// ==========================================
function onStartAccess(): void {
	if (isProcessing.value) return

	if (faceCount.value == 0) {
		toastMessage('请先录入人脸特征')
		return
	}

	isProcessing.value = true
	toastMessage('正在启动门禁识别...')

	startFaceAccessActivity(
		threshold.value,
		needLiveness.value,
		(result: ResultJSON) => {
			if (result.code != 0) {
				toastMessage(result.msg)
			}
			showResult(result)
			// 回写最新人数（可能期间录入/删除）
			faceCount.value = getFaceCount()
		},
	)
}

function goEnroll(): void {
	// 返回首页去录入人脸
	uni.navigateBack({
		fail: () => {
			uni.reLaunch({ url: '/pages/index/index' })
		}
	})
}
</script>

<style>
