	background-color: rgba(16, 185, 129, 0.25);
}

.result-denied {
	background-color: #FEF2F2;
	border-color: #FCA5A5;
}

.result-denied .result-glow {
	background-color: rgba(239, 68, 68, 0.2);
}

.result-idle {
	background-color: #F8FAFC;
	border-color: #E2E8F0;
}

.result-badge {
	font-size: 56rpx;
	font-weight: 700;
	text-align: center;
	margin-bottom: 8rpx;
}

.result-granted .result-badge {
	color: #10B981;
}

.result-denied .result-badge {
	color: #EF4444;
}

.result-idle .result-badge {
	color: #6B7280;
}

.result-title {
	font-size: 34rpx;
	font-weight: 700;
	text-align: center;
	color: #1F2937;
	margin-bottom: 20rpx;
}

.result-item {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: flex-start;
	padding: 12rpx 0;
	border-bottom: 2rpx solid rgba(0, 0, 0, 0.06);
}

.result-item:last-child {
	border-bottom-width: 0;
}

.result-label {
	font-size: 26rpx;
	color: #6B7280;
	flex-shrink: 0;
	margin-right: 20rpx;
}

.result-value {
	font-size: 26rpx;
	color: #1F2937;
	font-weight: 500;
	text-align: right;
	flex: 1;
}

.result-value.highlight {
	color: #10B981;
	font-weight: 700;
}

.btn-clear {
	width: 100%;
	height: 76rpx;
	margin-top: 20rpx;
	border-radius: 12rpx;
	background-color: transparent;
	border: 2rpx solid rgba(0, 0, 0, 0.1);
	color: #606266;
	font-size: 26rpx;
}

.btn-clear:active {
	background-color: rgba(0, 0, 0, 0.04);
}

/* ========== 底部 ========== */
.footer {
	display: flex;
	flex-direction: row;
	justify-content: center;
