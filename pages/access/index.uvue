	font-size: 22rpx;
	letter-spacing: 6rpx;
	color: #FFFFFF;
	border: 2rpx solid rgba(255, 255, 255, 0.45);
	border-radius: 999rpx;
	padding: 4rpx 18rpx;
	margin-bottom: 18rpx;
	background-color: rgba(255, 255, 255, 0.15);
}

.title {
	font-size: 38rpx;
	font-weight: 700;
	color: #FFFFFF;
	text-align: center;
	margin-bottom: 10rpx;
}

